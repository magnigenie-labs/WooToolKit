includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
	- phpstan-baseline.neon

parameters:
	level: 5
	phpVersion: 70400
	paths:
		- wootoolkit.php
		- includes
		- kits
		- src
	scanFiles:
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	treatPhpDocTypesAsCertain: false
